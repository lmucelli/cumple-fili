<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Filipa • 15 años</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,500;1,400;1,600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#181818;
    --paper:#F6F5F2;
    --stone:#8E8D89;
    --smoke:#C7C6C1;
    --gold:#C9A86A;
    --radius:2px;
    --bg-frame:url("data:image/jpeg;base64,");
  }

  *{box-sizing:border-box;}

  html{
    scroll-snap-type:y mandatory;
    scroll-behavior:smooth;
  }

  body{
    margin:0;
    color:var(--ink);
    font-family:'Space Mono', monospace;
    background:#0c0c0c;
  }

  .panel{
    width:100%;
    min-height:100vh;
    min-height:100dvh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:clamp(28px, 6vh, 64px) clamp(20px, 6vw, 64px);
    position:relative;
    scroll-snap-align:start;
    background-image:var(--bg-frame);
    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
  }

  .card{
    width:100%;
    max-width:520px;
    background:rgba(246,245,242,0.96);
    padding:clamp(32px, 5vh, 56px) clamp(24px, 4vw, 44px);
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:24px;
    text-align:center;
    box-shadow:0 20px 50px -15px rgba(0,0,0,0.55);
  }

  .name{
    margin:0;
    font-family:'Fraunces', serif;
    font-style:italic;
    font-weight:400;
    font-size:clamp(48px, 11vw, 92px);
    line-height:0.95;
    letter-spacing:-0.01em;
  }

  .subtitle{
    margin:-14px 0 0;
    font-size:clamp(12px, 1.6vw, 15px);
    letter-spacing:0.35em;
    text-transform:uppercase;
    color:var(--stone);
  }

  .countdown-block{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:16px;
  }

  .label{
    margin:0;
    font-size:11px;
    letter-spacing:0.3em;
    text-transform:uppercase;
    color:var(--stone);
  }

  .countdown{
    display:flex;
    justify-content:center;
    gap:clamp(14px, 3vw, 30px);
  }

  .unit{
    display:flex;
    flex-direction:column;
    align-items:center;
  }

  .unit span{
    font-size:clamp(24px, 4vw, 38px);
    font-weight:700;
    font-variant-numeric:tabular-nums;
  }

  .unit small{
    margin-top:6px;
    font-size:10px;
    letter-spacing:0.15em;
    text-transform:uppercase;
    color:var(--stone);
  }

  .countdown-message{
    font-family:'Fraunces', serif;
    font-style:italic;
    font-size:clamp(18px, 3vw, 26px);
    margin:0;
  }

  .panel-grid{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:32px;
    width:100%;
  }

  .divider{
    width:60px;
    height:1px;
    background:var(--smoke);
  }

  @media (min-width:520px){
    .panel-grid{
      flex-direction:row;
      justify-content:center;
      gap:40px;
    }
    .divider{
      width:1px;
      height:100px;
    }
  }

  .date-block .day-name{
    margin:0;
    font-size:13px;
    letter-spacing:0.2em;
    text-transform:uppercase;
    color:var(--stone);
  }

  .date-block .day-number{
    margin:6px 0;
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:clamp(48px, 8vw, 78px);
    line-height:0.9;
  }

  .date-block .month-name{
    margin:0 0 16px;
    font-size:13px;
    letter-spacing:0.2em;
    text-transform:uppercase;
  }

  .date-block .time{
    margin:0;
    font-size:13px;
    color:var(--stone);
  }

  .venue-name{
    margin:10px 0 20px;
    font-family:'Fraunces', serif;
    font-style:italic;
    font-size:clamp(22px, 3.5vw, 30px);
  }

  .dresscode{
    margin:10px 0 0;
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:clamp(28px, 5vw, 42px);
    letter-spacing:0.02em;
  }

  .rsvp-copy, .gift-copy{
    margin:0;
    font-size:12.5px;
    line-height:1.8;
    max-width:320px;
  }

  .btn{
    display:inline-block;
    appearance:none;
    border:1px solid var(--ink);
    background:var(--ink);
    color:var(--paper);
    font-family:'Space Mono', monospace;
    font-size:11px;
    letter-spacing:0.2em;
    text-transform:uppercase;
    text-decoration:none;
    padding:14px 28px;
    border-radius:var(--radius);
    cursor:pointer;
  }

  .btn:focus-visible{
    outline:2px solid currentColor;
    outline-offset:3px;
  }

  .btn--pending{
    background:transparent;
    color:var(--stone);
    border-color:var(--smoke);
    cursor:default;
  }

  .monogram{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:64px;
    height:64px;
    border:1px solid var(--ink);
    border-radius:50%;
    font-family:'Fraunces', serif;
    font-style:italic;
    font-size:26px;
  }

  .wedge-link{
    position:absolute;
    bottom:22px;
    left:50%;
    transform:translateX(-50%);
    display:flex;
    padding:14px;
    z-index:2;
  }

  .wedge{
    width:0;
    height:0;
    border-left:12px solid transparent;
    border-right:12px solid transparent;
    border-top:14px solid var(--paper);
    filter:drop-shadow(0 2px 4px rgba(0,0,0,0.5));
  }

  @media (prefers-reduced-motion: no-preference){
    .wedge-link{ animation:nudge 1.8s ease-in-out infinite; }
    .panel--hero .card{ animation:rise 0.7s ease both; }
  }
  @keyframes nudge{
    0%, 100%{ transform:translate(-50%, 0); }
    50%{ transform:translate(-50%, 8px); }
  }
  @keyframes rise{
    from{ opacity:0; transform:translateY(10px); }
    to{ opacity:1; transform:translateY(0); }
  }

  .modal{
    position:fixed;
    inset:0;
    background:rgba(12,12,12,0.65);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    z-index:10;
  }
  .modal[hidden]{ display:none; }

  .modal-content{
    position:relative;
    width:100%;
    max-width:320px;
    background:var(--paper);
    color:var(--ink);
    padding:40px 28px 32px;
    text-align:center;
  }

  .modal-close{
    position:absolute;
    top:10px;
    right:14px;
    background:none;
    border:none;
    font-size:22px;
    line-height:1;
    color:var(--ink);
    cursor:pointer;
  }

  .alias{
    margin:0 0 20px;
    font-size:16px;
    font-weight:700;
    letter-spacing:0.02em;
    word-break:break-all;
  }

  .copy-feedback{
    margin:14px 0 0;
    font-size:11px;
    letter-spacing:0.15em;
    text-transform:uppercase;
    color:var(--stone);
  }
</style>
</head>
<body>

  <section id="s1" class="panel panel--hero">
    <div class="card">
      <h1 class="name">Filipa</h1>
      <p class="subtitle">15 años</p>
      <div class="countdown-block">
        <p class="label">La fiesta comienza en</p>
        <div id="countdown" class="countdown">
          <div class="unit"><span id="cd-days">00</span><small>días</small></div>
          <div class="unit"><span id="cd-hours">00</span><small>hs</small></div>
          <div class="unit"><span id="cd-minutes">00</span><small>min</small></div>
          <div class="unit"><span id="cd-seconds">00</span><small>seg</small></div>
        </div>
        <p id="countdown-message" class="countdown-message" hidden>¡La fiesta ya empezó!</p>
      </div>
    </div>
    <a href="#s2" class="wedge-link" aria-label="Ver fecha y salón"><span class="wedge"></span></a>
  </section>

  <section id="s2" class="panel panel--date">
    <div class="card">
      <div class="panel-grid">
        <div class="date-block">
          <p class="day-name">Sábado</p>
          <p class="day-number">26</p>
          <p class="month-name">Septiembre</p>
          <p class="time">Desde las 21:00 hs</p>
        </div>
        <div class="divider" aria-hidden="true"></div>
        <div class="venue-block">
          <p class="label">Salón</p>
          <p class="venue-name">Calle 13</p>
          <a class="btn" href="https://maps.app.goo.gl/9gsmpWgmqHZEGZYi7" target="_blank" rel="noopener">¿Cómo llego?</a>
        </div>
      </div>
    </div>
    <a href="#s3" class="wedge-link" aria-label="Ver dress code y asistencia"><span class="wedge"></span></a>
  </section>

  <section id="s3" class="panel panel--dress">
    <div class="card">
      <div class="panel-grid">
        <div class="dress-block">
          <p class="label">Dress code</p>
          <p class="dresscode">Elegante Sport</p>
        </div>
        <div class="divider" aria-hidden="true"></div>
        <div class="rsvp-block">
          <p class="label">Asistencia</p>
          <p class="rsvp-copy">Por favor Confirmá tu presencia.</p>
          <!-- Cuando tengas el link del formulario, reemplazá el <span> de abajo por:
               <a class="btn" href="TU_LINK_ACA" target="_blank" rel="noopener">Confirmar</a> -->
          <span class="btn btn--pending" aria-disabled="true">Muy pronto</span>
        </div>
      </div>
    </div>
    <a href="#s4" class="wedge-link" aria-label="Ver regalos"><span class="wedge"></span></a>
  </section>

  <section id="s4" class="panel panel--gift">
    <div class="card">
      <p class="gift-copy">Espero que puedas estar presente<br>para que juntos pasemos<br><span style="font-size:26px;"><em>una noche inolvidable.</em></span></p>
      <span class="monogram">F</span>
    </div>
  </section>

  </div>

<script>
  // Cuenta regresiva a las 21:00 hs (ARG, UTC-3) del sábado 26/09/2026
  var target = new Date("2026-09-26T21:00:00-03:00").getTime();

  function pad(n){ return String(n).padStart(2, "0"); }

  function tick(){
    var diff = target - Date.now();
    if (diff <= 0){
      document.getElementById("countdown").hidden = true;
      document.getElementById("countdown-message").hidden = false;
      clearInterval(timer);
      return;
    }
    var days = Math.floor(diff / 86400000);
    var hours = Math.floor((diff % 86400000) / 3600000);
    var minutes = Math.floor((diff % 3600000) / 60000);
    var seconds = Math.floor((diff % 60000) / 1000);
    document.getElementById("cd-days").textContent = pad(days);
    document.getElementById("cd-hours").textContent = pad(hours);
    document.getElementById("cd-minutes").textContent = pad(minutes);
    document.getElementById("cd-seconds").textContent = pad(seconds);
  }

  var timer = setInterval(tick, 1000);
  tick();

  var modal = document.getElementById("gift-modal");
  document.getElementById("open-gift").addEventListener("click", function(){
    modal.hidden = false;
  });
  document.getElementById("close-gift").addEventListener("click", function(){
    modal.hidden = true;
  });
  modal.addEventListener("click", function(e){
    if (e.target === modal) modal.hidden = true;
  });

  document.getElementById("copy-alias").addEventListener("click", function(){
    var text = document.getElementById("alias-text").textContent.trim();
    var feedback = document.getElementById("copy-feedback");
    navigator.clipboard.writeText(text).then(function(){
      feedback.hidden = false;
      setTimeout(function(){ feedback.hidden = true; }, 2000);
    });
  });
</script>

</body>
</html>
